{
  "mcpServers": {
    "burp": {
      "type": "stdio",
      "command": "java.exe",
      "args": [
        "-jar",
        "mcp-proxy.jar",
        "--sse-url",
        "http://127.0.0.1:9876"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx.cmd",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
  }
}