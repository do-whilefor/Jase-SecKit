{
  "mcpServers": {
    "burp": {
      "type": "stdio",
      "command": "/BurpSuite/jre/bin/java",
      "args": [
        "-jar",
        "/BurpSuite/mcp-proxy.jar",
        "--sse-url",
        "http://127.0.0.1:9876"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
