    {
      "id": "test_ip",
      "label": "测试源IP",
      "kind": "text",
      "required": true,
      "map_from": "实际测试源 IP，允许受控原件定位或人工补填",
      "group": "test_ips",
      "notes": "可添加多组；未确认格式、字数或组数上限。"
    },
    {
      "id": "test_account",
      "label": "测试账号：账号",
      "kind": "text",
      "required": true,
      "map_from": "该测试身份的一致代号或受控账号定位",
      "group": "test_accounts",
      "max_length": 50,
      "notes": "越权类漏洞页面要求至少两个测试账号；无需登录可填“无需账号”。这不证明密码框可以留空。"
    },
    {
      "id": "test_password",
      "label": "测试账号：密码",
      "kind": "text",
      "required": true,
      "map_from": "对应身份密码的受控原件定位/人工补填",
      "group": "test_accounts",
      "max_length": 50,
      "manual": true,
      "notes": "页面普通文本框且所在表单项 is-required；分享产物不输出真实密码。无需登录时如何填写未确认。"
    },
    {
      "id": "request_packet",
      "label": "数据请求包1",
      "kind": "multiline",
      "required": true,
      "map_from": "该请求的完整结构化内容（分享版脱敏）及受控原件定位",
      "group": "request_packets",
      "max_length": 60000,
      "notes": "“1”为第一组显示序号；每组含危害类型和漏洞危害描述。涉及网络请求需完整POST/GET数据；组合漏洞拆分多组。"
    },
    {
      "id": "harm_type",
      "label": "危害类型",
      "kind": "select",
      "required": true,
      "map_from": "该请求证据支持的危害类型",
      "group": "request_packets",
      "options": [
        "入侵危害",
        "盗号危害",
        "数据泄露危害",
        "其他危害"
      ]
    },
    {
      "id": "impact_description",
      "label": "漏洞危害描述",
      "kind": "multiline",
      "required": true,
      "map_from": "该请求已观察的影响与范围，明确证据边界",
      "group": "request_packets",
      "max_length": 200,
      "notes": "页面占位含“****条敏感信息”；未观察的规模不能由示例或脚本循环推断。"
    },
    {
      "id": "core_network",
      "label": "是否核心内网",
      "kind": "select",
      "required": true,
      "map_from": "证明内网范围的事实；不足时待确认",
      "group": "request_packets",
      "when": {
        "field": "harm_type",
        "equals": "入侵危害"
      },
      "options": [
        "是",
        "否"
      ],
      "notes": "展开时“否”已选；默认不构成范围判断，选择“是”或“否”均显示网段证明截图。"
    },
    {
      "id": "network_screenshots",
      "label": "网段证明截图",
      "kind": "attachments",
      "required": null,
      "map_from": "当前请求组的网段证明截图材料",
      "group": "request_packets",
      "when": {
        "field": "harm_type",
        "equals": "入侵危害"
      },
      "max_items": 3,
      "extensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".gif",
        ".webp"
      ],
      "size_limit": {
        "label": "单个文件不超过 1M",
        "bytes": 1000000,
        "inclusive": true,
        "basis": "conservative_decimal",
        "scope": "per_file"
      },
      "notes": "JPEG/PNG/GIF/WEBP；未标必填。1M对应字节数未验证；此阈值仅为保守十进制检查，不是已确认服务器规则。"
    },
    {
      "id": "account_credentials",
      "label": "账号信息凭证",
      "kind": "multiline",
      "required": true,
      "map_from": "凭证种类、脱敏说明及受控原件定位/人工补填",
      "group": "request_packets",
      "when": {
        "field": "harm_type",
        "equals": "盗号危害"
      },
      "max_length": 200,
      "manual": true,
      "notes": "页面占位：账号密码/cookie/aksk/其他。分享产物不得机械复制密码、cookie或AK/SK。"
    },
    {
      "id": "steps",
      "label": "复现步骤",
      "kind": "richtext",
      "required": true,
      "map_from": "按 body_sections 组织复现正文并引用材料",
      "notes": "一个富文本编辑器，可插入图像和代码段；无独立修复建议或通用附件控件。编辑器插图限制未确认。"
    },
    {
      "id": "captcha",
      "label": "验证码",
      "kind": "text",
      "required": true,
      "map_from": "交由用户在页面获取并填写",
      "manual": true,
      "notes": "图片验证码支持换一张；报告生成阶段不能代为验证。"
    },
    {
      "id": "agreement",
      "label": "用户协议",
      "kind": "boolean",
      "required": true,
      "map_from": "用户阅读京东安全用户协议后人工选择",
      "manual": true,
      "notes": "https://security.jd.com/#/protocol"
    },
    {
      "id": "flag_type",
      "label": "FLAG 类型",
      "kind": "cascade",
      "required": null,
      "map_from": "仅在用户选择使用 FLAG 模块时人工选择",
      "group": "flag",
      "manual": true,
      "option_paths": [
        [
          "入侵类",
          "SSRF漏洞验证"
        ],
        [
          "入侵类",
          "RCE漏洞验证"
        ]
      ],
      "notes": "模块受账号权限控制；本次只检查界面，未生成或验证FLAG。"
    },
    {
      "id": "flag_level",
      "label": "FLAG 级别",
      "kind": "text",
      "required": null,
      "map_from": "页面系统显示",
      "group": "flag",
      "manual": true,
      "read_only": true,
      "notes": "禁用只读显示框，不需要手工填写。"
    },
    {
      "id": "flag_credential",
      "label": "FLAG 凭证",
      "kind": "text",
      "required": null,
      "map_from": "页面系统显示",
      "group": "flag",
      "manual": true,
      "read_only": true,
      "notes": "禁用只读状态框，区别于“填入有效FLAG凭证”。"
    },
    {
      "id": "silver_activation",
      "label": "激活白银凭证",
      "kind": "text",
      "required": null,
      "map_from": "页面系统显示；生成操作由用户人工执行",
      "group": "flag",
      "manual": true,
      "read_only": true,
      "when": {
        "field": "flag_type",
        "equals": [
          "入侵类",
          "SSRF漏洞验证"
        ]
      },
      "notes": "只读框旁有生成按钮；未执行生成。"
    },
    {
      "id": "ssrf_credential",
      "label": "填入有效FLAG凭证",
      "kind": "text",
      "required": null,
      "map_from": "用户通过授权验证流程取得的凭证，人工填写",
      "group": "flag",
      "manual": true,
      "when": {
        "field": "flag_type",
        "equals": [
          "入侵类",
          "SSRF漏洞验证"
        ]
      },
      "notes": "占位 InvasionSilverFlag{...}；旁有验证按钮，未执行验证。"
    },
    {
      "id": "rce_credential",
      "label": "填入有效FLAG凭证",
      "kind": "text",
      "required": null,
      "map_from": "用户通过授权验证流程取得的凭证，人工填写",
      "group": "flag",
      "manual": true,
      "when": {
        "field": "flag_type",
        "equals": [
          "入侵类",
          "RCE漏洞验证"
        ]
      },
      "notes": "占位 InvasionDiamondFlag{...}；旁有验证按钮。核心内网主机RCE验证说明与复制指令入口不是额外字段，未执行。"
    }
  ],
  "body_sections": [
    {
      "id": "entry_point",
      "label": "漏洞出现点或请求发起的位置和方式",
      "map_from": "受影响网站、功能页面与功能点",
      "notes": "按 网站 → 功能页面 → 功能点 描述。"
    },
    {
      "id": "reproduction",
      "label": "操作思路、具体方式及工具",
      "map_from": "带证据定位的有序步骤、URL、接口、请求响应与观察结果",
      "notes": "每个关键操作附对应截图；不把PoC设计意图作为成功结果。"
