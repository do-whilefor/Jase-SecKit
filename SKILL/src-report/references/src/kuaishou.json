    {
      "id": "request_packet",
      "label": "触发请求包",
      "kind": "multiline",
      "required": true,
      "map_from": "完整触发请求结构、脱敏内容与受控原件定位",
      "max_length": 10000,
      "notes": "页面计数0/10000，未实测超长处理。POST填写触发请求，GET贴完整漏洞链接；组合漏洞在本字段拆分多数据包，未观察到重复控件。"
