    {
      "id": "details",
      "label": "漏洞详情",
      "kind": "richtext",
      "required": true,
      "map_from": "按 body_sections 组织Markdown正文",
      "notes": "页面为带工具栏和预览的Markdown编辑区；kind=richtext仅表示带格式的正文，不表示HTML编辑器。"
    },
    {
      "id": "remediation",
      "label": "修复建议",
      "kind": "multiline",
      "required": true,
      "map_from": "与根因对应的具体修复或加固方案",
      "notes": "快手有独立修复建议字段，不能只放在详情中。"
    },
    {
      "id": "attachments",
      "label": "上传附件",
      "kind": "attachments",
      "required": null,
      "map_from": "PDF/ZIP/RAR材料登记和分享副本清单",
      "extensions": [
        ".pdf",
        ".zip",
        ".rar"
      ],
      "size_limit": {
        "label": "可上传多个.pdf/.zip/.rar格式文件，小于10M",
        "bytes": 10000000,
        "inclusive": false,
        "basis": "conservative_decimal",
        "scope": "unknown"
      },
      "notes": "未展示数量上限；10M为单文件还是合计、单位字节含义均未确认。若大于10M或需补充附件/视频，页面建议通过轻雀云文档上传；生成技能不自动上传。"
    },
