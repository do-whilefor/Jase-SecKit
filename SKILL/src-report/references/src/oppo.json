      "id": "details",
      "label": "漏洞详情",
      "kind": "richtext",
      "required": true,
      "map_from": "按 body_sections 六节组织正文并关联证据和附件步骤编号",
      "notes": "修复建议小节明确选填；其余模板标注必填的内容不足时列明缺口。正文长度、编辑器插图规则未核对。"
    },
    {
      "id": "attachments",
      "label": "上传文件",
      "kind": "attachments",
      "required": null,
      "map_from": "与复现步骤逐一对应、已登记且经脱敏复核的附件清单",
      "extensions": [
