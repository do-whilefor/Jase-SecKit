      "size_limit": {
        "label": "doc、docx、7z、zip、gz、bz2、excel 请上传小于20M的文件",
        "bytes": 20000000,
        "inclusive": false,
        "basis": "conservative_decimal",
        "scope": "per_file"
      },
      "notes": "文件控件无 multiple，只能说明单次选择一文件，不代表总数上限为1。独立上传入口未标星，正文附件POC小节标必填，二者不能混同。M 字节换算和实际接受边界未验证。"
    },
