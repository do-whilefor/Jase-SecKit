    {
      "id": "severity",
      "label": "漏洞等级",
      "kind": "select",
      "required": true,
      "map_from": "依据证据和平台评级规则自评；不能由 CVSS 分数自动映射",
      "options": [
        "无",
        "低",
        "中",
        "高",
        "严重"
      ],
      "when": {
        "field": "type_primary",
        "in": [
          "web漏洞",
          "android漏洞",
          "PC客户端漏洞",
          "智能硬件",
          "威胁情报",
          "iOS漏洞",
          "android隐私漏洞",
          "iOS隐私漏洞",
          "大语言模型"
        ]
      },
      "notes": "选择样本收集时此字段隐藏。"
    },
    {
      "id": "mobile_model",
      "label": "手机型号",
      "kind": "text",
      "required": true,
      "map_from": "实际复现手机型号",
      "when": {
        "field": "type_primary",
        "in": [
          "android漏洞",
          "iOS漏洞"
        ]
      }
    },
    {
      "id": "system_version",
      "label": "系统版本",
      "kind": "text",
      "required": true,
      "map_from": "实际复现设备系统版本",
      "when": {
        "field": "type_primary",
        "in": [
          "android漏洞",
          "iOS漏洞"
        ]
      }
    },
    {
      "id": "app_package",
      "label": "软件包名",
      "kind": "text",
      "required": true,
      "map_from": "实际受影响软件包名",
      "when": {
        "field": "type_primary",
        "in": [
          "android漏洞",
          "iOS漏洞"
        ]
      }
    },
    {
      "id": "app_version",
      "label": "软件版本",
      "kind": "text",
      "required": true,
      "map_from": "实际复现 APP 版本",
      "when": {
        "field": "type_primary",
        "in": [
          "android漏洞",
          "iOS漏洞"
        ]
      }
    },
    {
      "id": "app_download",
      "label": "APP下载包",
      "kind": "attachments",
      "required": true,
      "map_from": "已登记的对应版本 APP 安装包",
      "when": {
        "field": "type_primary",
        "in": [
          "android漏洞",
          "iOS漏洞"
        ]
      },
      "extensions": [
        ".ipa",
        ".apk"
      ],
      "size_limit": {
        "label": "允许上传150M以内ipa/apk格式的文件",
        "bytes": 150000000,
        "inclusive": true,
        "basis": "conservative_decimal",
        "scope": "unknown"
      },
      "notes": "与报告附件是独立上传控件；数量上限和大小作用范围未明确，不能伪造安装包。"
    },
    {
      "id": "app_source",
      "label": "APP下载来源",
      "kind": "text",
      "required": true,
      "map_from": "该安装包的真实下载来源或取得路径",
      "when": {
        "field": "type_primary",
        "in": [
          "android漏洞",
          "iOS漏洞"
        ]
      }
    },
    {
      "id": "device_name",
      "label": "设备名称",
      "kind": "text",
      "required": true,
      "map_from": "实际受影响智能硬件名称",
      "when": {
        "field": "type_primary",
        "equals": "智能硬件"
      }
    },
    {
      "id": "device_version",
      "label": "设备版本",
      "kind": "text",
      "required": true,
      "map_from": "实际复现硬件版本",
      "when": {
        "field": "type_primary",
        "equals": "智能硬件"
      }
    },
    {
      "id": "software_name",
      "label": "软件名称",
      "kind": "text",
      "required": true,
      "map_from": "智能硬件中受影响软件名称",
      "when": {
        "field": "type_primary",
        "equals": "智能硬件"
      }
    },
    {
      "id": "software_version",
      "label": "软件版本",
      "kind": "text",
      "required": true,
      "map_from": "智能硬件中实际复现软件版本",
      "when": {
        "field": "type_primary",
        "equals": "智能硬件"
      }
    },
    {
      "id": "url",
      "label": "漏洞 Url",
      "kind": "text",
      "required": true,
      "map_from": "存在漏洞的具体 URL 或请求入口",
      "when": {
        "field": "type_primary",
        "equals": "web漏洞"
      },
      "notes": "页面提示：请提供漏洞Url，如反射XSS等可直接提供相应payload。"
    },
    {
      "id": "details",
      "label": "漏洞详情",
      "kind": "richtext",
      "required": true,
      "map_from": "按 body_sections 组织详细说明、漏洞证明与修复方案",
      "notes": "单个富文本编辑器；三段模板不是三个独立表单字段。"
    },
    {
      "id": "attachments",
      "label": "上传附件",
      "kind": "attachments",
      "required": null,
      "map_from": "已登记的报告 PDF 与证据材料清单",
      "when": {
        "field": "type_primary",
        "in": [
          "web漏洞",
          "android漏洞",
          "PC客户端漏洞",
          "智能硬件",
          "威胁情报",
          "iOS漏洞",
          "android隐私漏洞",
          "iOS隐私漏洞",
          "大语言模型"
        ]
      },
      "extensions": [
        ".pdf"
      ],
      "size_limit": {
        "label": "仅允许上传10M以内pdf格式",
        "bytes": 10000000,
        "inclusive": true,
        "basis": "conservative_decimal",
        "scope": "unknown"
      },
      "notes": "与 sample_attachment 是同一物理上传控件在互斥分类下的不同规则。当前分支未标必填；数量和单文件/合计范围未确认。"
    },
    {
      "id": "sample_attachment",
      "label": "上传样本",
      "kind": "attachments",
      "required": true,
      "map_from": "已登记的样本 ZIP；仅整理来源和用途，不执行样本",
      "when": {
        "field": "type_primary",
        "equals": "样本收集"
      },
      "extensions": [
        ".zip"
      ],
      "size_limit": {
        "label": "仅允许上传1M以内zip格式",
        "bytes": 1000000,
        "inclusive": true,
        "basis": "conservative_decimal",
        "scope": "unknown"
      },
      "notes": "样本收集时同一附件控件改为必填，名称、格式与大小限制同时变化；不要另外添加 PDF 附件字段。"
    },
    {
      "id": "captcha",
      "label": "验证码",
      "kind": "text",
      "required": true,
      "map_from": "用户在页面获取并填写",
      "manual": true,
      "notes": "图片验证码有换一张入口；报告阶段不填写验证码。"
    },
    {
      "id": "agreement",
      "label": "360SRC 用户协议",
      "kind": "boolean",
      "required": null,
      "map_from": "用户阅读360SRC用户协议后人工选择",
      "manual": true,
      "notes": "页面显示我已阅读并同意，未标星号；提交是否要求勾选未实测。"
    }
  ],
  "body_sections": [
    {
      "id": "description",
      "label": "一、详细说明",
      "map_from": "受影响业务、版本、入口、前提及按顺序的复现步骤"
    },
    {
      "id": "proof",
      "label": "二、漏洞证明",
      "map_from": "实际请求响应、结果截图与已观察影响，关联证据定位并明确未验证范围"
    },
    {
      "id": "remediation",
      "label": "三、修复方案",
      "map_from": "针对已确认根因提出可执行修复建议，明确为建议"
    }
  ]
}
