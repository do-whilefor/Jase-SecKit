{
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "command": "npx.cmd",
        "args": [
          "-y",
          "chrome-devtools-mcp@latest",
          "--autoConnect",
          "--channel=stable",
          "--accept-insecure-certs",
          "--experimental-page-id-routing",
          "--experimental-devtools",
          "--experimental-vision",
          "--experimental-structured-content",
          "--experimental-include-all-pages",
          "--memory-debugging",
          "--category-experimental-third-party",
          "--allow-unrestricted-paths",
          "--no-usage-statistics",
          "--no-performance-crux",

          "--screenshot-format=webp",
          "--screenshot-quality=85",
          "--screenshot-max-width=1920",
          "--screenshot-max-height=1080"
        ],
        "timeoutMs": 120000,
        "enabled": true
      },
      "burp": {
        "command": "【绝对路径】\\java.exe",
        "args": [
          "-jar",
          "【绝对路径】\\mcp-proxy.jar",
          "--sse-url",
          "http://127.0.0.1:9876"
        ],
        "tool_timeout_sec": 120000,
        "default_tools_approval_mode": "approve"
      }
    }
  },
  "plugins": {
    "suppressedBuiltins": [
      "browser-use@zcode-plugins-official",
      "skill-creator@zcode-plugins-official",
      "android-emulator@zcode-plugins-official",
      "ios-simulator@zcode-plugins-official",
      "document-skills@zcode-plugins-official",
      "restore-legacy-sessions@zcode-plugins-official",
      "zcode-guide@zcode-plugins-official"
    ]
  }
}
